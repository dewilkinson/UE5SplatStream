// SplatPakDisc.usf
// Step 1 of the Unreal port: opaque, depth-tested discs from 8-byte point records or 20-byte splat records.
// Ported from Splat.hlsl in the 3DGSStream repo (BuildSplat render modes 1 and 4, mainAS/mainMS,
// mainVS, mainPS). Differences from the original:
//  - Unreal matrices are row-vector: mul(float4(p, 1), ModelToClip).
//  - Records are read from one uint buffer (WordsPerRecord words each) so both formats share a path.
//  - Discs are hard-edged and opaque (depth write, no blending): they land in Unreal's depth buffer
//    for TSR and occlusion. SplatPak's soft blended disc edge returns with the sorted splat pass.
//  - Oct16 normals are decoded as the two signed bytes PackNormalOct16 writes (Splat.hlsl reads
//    them as unsigned; see the note in the plugin docs).
//  - Splat records draw with their DC colour only; spherical harmonics arrive with step 3.
//  - Output is linear and pre-exposed, as Unreal's scene colour expects, scaled by EmissiveIntensity:
//    the stored colours are baked light, so they behave like an emissive surface under Unreal's exposure.
// Chunk-level culling: frustum and occlusion tests in the amplification shader (occlusion against the
// package's occluder mesh, SplatPakOcclusion.ush); the vertex fallback leaves culling to the rasterizer and
// the depth test. Normal-cone culling arrives with step 2.
// Streaming (USplatPakComponent with streaming on): the meshlets are the runtime's render list, mixing levels. Each disc
// takes its level's radius (LevelRadii), a meshlet mid cross-fade is dithered against its parent or children with
// SplatPak's 8x8 Bayer pattern (BlendWeight: +t fading in, -t fading out), and a block just delivered glows in its
// level's hue (IsSilhouette carries the arrival wave, ArrivalGlow), as SplatPak's Refinement Visualizer draws it.

#include "/Engine/Private/Common.ush"

#define SPLATS_PER_GROUP 64
#define AS_GROUP_SIZE 32

struct FSplatPakMeshlet
{
	float3 Center;
	float  BoundingRadius;
	float3 AabbMin;
	uint   SplatOffset;
	float3 AabbExtents;
	uint   SplatCount;
	float  BlendWeight;
	uint   LodLevel;
	float  DilationMorph;
	float  IsSilhouette;
	float3 ConeAxis;
	float  ConeCutoff;
};

StructuredBuffer<uint>           Records;
StructuredBuffer<FSplatPakMeshlet> Meshlets;
float4x4 ModelToClip;
float3   CamRightModel;
float    SplatScale;
float3   CamUpModel;
float    GlowIntensity; // Refinement Visualizer strength (1 = SplatPak's full glow)
float3   EyeModel;
float    ClipWToModel;  // Clip-space w (world units) to model units
float3   QuantMin;
uint     RecordFormat;  // 0 = 8-byte point record, 1 = 20-byte splat record
float3   QuantExtents;
uint     MeshletCount;
float3   LightDirModel;
uint     OrientMode;    // 0 = tangent-plane disc, 1 = camera-facing billboard
float    ScaleLog2Min;
float    ScaleLog2Max;
float    PreExposure;
uint     WordsPerRecord;
float    EmissiveIntensity; // Brightness of the stored (baked) colour as emissive light; 1 = as stored
float3   ColourGain;        // The colour grade, linear: colour * ColourGain + ColourOffset (FSplatPakDrawSettings)
float3   ColourOffset;
float    ColourSaturation;  // The grade's saturation, about the luminance, after the gain
StructuredBuffer<uint> OccDepth; // Occlusion grid (SplatPakOcclusion.ush)
uint     OcclusionCull;  // 1 = drop meshlets hidden behind the occluder mesh; 2 = draw only those (debug)
uint     OccWidth;
uint     OccHeight;
float    OccNearW;       // The view's near-plane distance (clip w)
float    OccMeshletPad;  // The largest disc radius (model units): a meshlet's bounds cover centres, its discs reach this much further
uint     StreamFlags;    // Bit 0: dither cross-fades by BlendWeight; bit 1: Refinement Visualizer (arrival glow)
float    GlowHue;        // Rotates every level's glow hue, degrees (0 = gold at level 0)
float4   LevelRadii[2];  // Auto splat size per level: the level's point spacing x coverage (model units); 0 = size classes
// Lit mode (MainGBufferPS)
float4x4 ModelToWorldNormal; // Inverse transpose of model to world
uint     LitMode;        // 1 = GBuffer pass: point records skip SplatPak's key light (Unreal's lights replace it)
float    LitBlend;       // 0 = the baked colour as emissive (the unlit look), 1 = the colour as albedo, fully lit
float    LitRoughness;
float    LitSpecular;
float    AlbedoScale;    // The baked colour times this is the albedo
Texture2D MeshNormalTexture;  // The shadow mesh's smooth world normals (xyz) and clip w (w; 0 = no mesh at the pixel)
float    NormalSmoothing;     // 0 = the splat's own normal, 1 = the shadow mesh's where the disc lies on it
float    MeshNormalTolerance; // How far (clip w, world units) a disc may lie from the mesh and still take its normal

#include "/Plugin/SplatPak/Private/SplatPakOcclusion.ush"

struct FSplatPakVSOut
{
	float4 Position : SV_POSITION;
	float2 UV       : TEXCOORD0;
	float3 Color    : TEXCOORD1; // Display-space colour (as stored), before the arrival glow
	nointerpolation float BlendWeight : TEXCOORD2; // The meshlet's cross-fade (1 = solid)
	float3 WorldNormal : TEXCOORD3; // The disc's normal, facing the camera (lit mode)
	float3 Glow     : TEXCOORD4; // The arrival glow, display space: Color + Glow is what the unlit pass draws
};

static const float2 QuadCorners[4] = { float2(-1.0, -1.0), float2(1.0, -1.0), float2(-1.0, 1.0), float2(1.0, 1.0) };
static const uint QuadVertexCorner[6] = { 0, 1, 2, 1, 3, 2 };
// A vertex the rasterizer drops: z < 0 is clipped whichever way the depth range runs.
static const float4 CulledClipPos = float4(0.0, 0.0, -2.0, 1.0);
// About one screen pixel of world radius per unit of distance (kPixelRadiusPerDistance in SplatPak).
static const float PixelRadiusPerDistance = 0.00075;

// ---------------------------------------------------------------------------------------------
// Decode helpers
// ---------------------------------------------------------------------------------------------

uint RecordWord(uint SplatIndex, uint Word)
{
	return Records[SplatIndex * WordsPerRecord + Word];
}

float3 DecodeOct16(uint Packed)
{
	// Two signed bytes, as PackNormalOct16 writes them.
	float2 E = float2((int)(Packed << 24) >> 24, (int)(Packed << 16) >> 24) / 127.0;
	float3 V = float3(E.x, E.y, 1.0 - abs(E.x) - abs(E.y));
	if (V.z < 0.0)
	{
		float2 SignNotZero = float2(V.x >= 0.0 ? 1.0 : -1.0, V.y >= 0.0 ? 1.0 : -1.0);
		V.xy = (1.0 - abs(V.yx)) * SignNotZero;
	}
	return normalize(V);
}

float3 DecodeRGB565(uint Packed)
{
	return float3((Packed >> 11) & 0x1F, (Packed >> 5) & 0x3F, Packed & 0x1F) / float3(31.0, 63.0, 31.0);
}

float3x3 QuatToMat3(float4 Q)
{
	float X = Q.x, Y = Q.y, Z = Q.z, W = Q.w;
	return float3x3(
		1.0 - 2.0 * (Y * Y + Z * Z), 2.0 * (X * Y - W * Z),       2.0 * (X * Z + W * Y),
		2.0 * (X * Y + W * Z),       1.0 - 2.0 * (X * X + Z * Z), 2.0 * (Y * Z - W * X),
		2.0 * (X * Z - W * Y),       2.0 * (Y * Z + W * X),       1.0 - 2.0 * (X * X + Y * Y));
}

float3 SRGBToLinearColor(float3 C)
{
	float3 Lo = C / 12.92;
	float3 Hi = pow(max(C + 0.055, 0.0) / 1.055, 2.4);
	return float3(C.x <= 0.04045 ? Lo.x : Hi.x, C.y <= 0.04045 ? Lo.y : Hi.y, C.z <= 0.04045 ? Lo.z : Hi.z);
}

// ---------------------------------------------------------------------------------------------
// Per-splat disc construction (BuildSplat, render modes 1 and 4)
// ---------------------------------------------------------------------------------------------

struct FSplatPakDisc
{
	float3 Center;
	float3 TangentX;
	float3 TangentY;
	float3 Color;
	float3 Glow;   // The arrival glow, added to Color by the unlit pass
	float3 Normal; // Model space, facing the camera
};

void SplatTangents(float3 Normal, float Radius, out float3 TangentX, out float3 TangentY)
{
	if (OrientMode == 0 && abs(Normal.x) + abs(Normal.y) + abs(Normal.z) > 0.1)
	{
		float3 Up = abs(Normal.y) < 0.99 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
		float3 TX = normalize(cross(Up, Normal));
		TangentX = TX * Radius;
		TangentY = cross(Normal, TX) * Radius;
	}
	else
	{
		TangentX = CamRightModel * Radius;
		TangentY = CamUpModel * Radius;
	}
}

// Sub-pixel discs become camera-facing dots of at least a pixel (SolidDot in SplatPak).
void SolidDot(float DistToCam, inout float3 TangentX, inout float3 TangentY)
{
	float OnePixel = DistToCam * PixelRadiusPerDistance;
	float Radius = max(length(TangentX), length(TangentY));
	if (Radius < OnePixel * 1.5)
	{
		float R = max(Radius, OnePixel);
		TangentX = CamRightModel * R;
		TangentY = CamUpModel * R;
	}
}

float LevelRadiusOf(uint Lod)
{
	const uint L = min(Lod, 7u);
	return LevelRadii[L >> 2][L & 3];
}

float AutoSplatRadius(float ClassRadius, float ClassScale, uint Lod)
{
	const float LevelRadius = LevelRadiusOf(Lod);
	return (LevelRadius > 0.0) ? SplatScale * LevelRadius * min(ClassScale, 2.5) : ClassRadius;
}

float3 HsvToRgb(float HueDegrees, float S, float V)
{
	const float H = frac(HueDegrees / 360.0) * 6.0;
	const float3 K = saturate(abs(fmod(H + float3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0);
	return V * lerp(float3(1.0, 1.0, 1.0), K, S);
}

// Hue offset of the arrival glow per level (kArrivalGlowLevelHue in SplatPak's Splat.hlsl): consecutive levels sit across
// the colour wheel from one another, so the level a block brings is readable as it arrives
static const float LevelGlowHue[8] = { 0.0, 180.0, 90.0, 270.0, 315.0, 135.0, 45.0, 225.0 };

// SplatPak's arrival glow (Splat.hlsl ArrivalGlow): W is the block's wave, 0.95 just delivered -> 0 faded
void ArrivalGlow(inout float3 Color, float W, uint Lod)
{
	const float Life = saturate(W / 0.95);
	const float Fade = Life * Life * (3.0 - 2.0 * Life);
	const float Heat = Life * Life * Life;
	const float Hue = 45.0 + GlowHue + LevelGlowHue[min(Lod, 7u)];
	const float3 GoldTint = HsvToRgb(Hue, 0.85, 1.0);
	const float3 HotTint = HsvToRgb(Hue, 0.35, 1.0);
	const float3 Tint = lerp(GoldTint, HotTint, Heat);
	const float Opacity = saturate(0.70 * GlowIntensity) * Fade;
	Color = lerp(Color, Tint * (1.0 + 0.5 * Heat), Opacity);
	Color += GoldTint * (Fade * 0.45 * GlowIntensity) + HotTint * (Heat * 0.6 * GlowIntensity);
}

bool BuildDisc(uint SplatIndex, uint Lod, float Wave, out FSplatPakDisc Disc)
{
	Disc = (FSplatPakDisc)0;
	float3 Normal;
	float Radius;
	bool bLit;

	if (RecordFormat == 0)
	{
		uint W0 = RecordWord(SplatIndex, 0);
		uint W1 = RecordWord(SplatIndex, 1);
		Disc.Center = QuantMin + float3(W0 & 0x3FF, (W0 >> 10) & 0x3FF, (W0 >> 20) & 0x3FF) / 1023.0 * QuantExtents;
		Normal = DecodeOct16(W1 & 0xFFFF);
		Disc.Color = DecodeRGB565(W1 >> 16);

		uint RadiusExp = (W0 >> 30) & 0x3;
		float RadScale = (RadiusExp == 0) ? 1.0 : (RadiusExp == 1) ? 1.5 : (RadiusExp == 2) ? 2.5 : 4.5;
		float MaxExtent = max(QuantExtents.x, max(QuantExtents.y, QuantExtents.z));
		float BaseVoxelRadius = max(0.0005, (MaxExtent / 1024.0) * 1.35);
		Radius = AutoSplatRadius(SplatScale * BaseVoxelRadius * RadScale, RadScale, Lod);
		bLit = true;
	}
	else
	{
		uint W0 = RecordWord(SplatIndex, 0);
		uint W1 = RecordWord(SplatIndex, 1);
		uint W2 = RecordWord(SplatIndex, 2);
		uint W3 = RecordWord(SplatIndex, 3);
		uint W4 = RecordWord(SplatIndex, 4);

		float Opacity = ((W2 >> 8) & 0xFF) / 255.0;
		if (Opacity <= 1.0 / 255.0)
		{
			return false; // Records the sorted splat pipeline never draws
		}
		Disc.Center = QuantMin + float3(W0 & 0xFFFF, (W0 >> 16) & 0xFFFF, W1 & 0xFFFF) / 65535.0 * QuantExtents;
		float3 Scale = exp2(ScaleLog2Min + (float3((W1 >> 16) & 0xFF, (W1 >> 24) & 0xFF, W2 & 0xFF) / 255.0) * (ScaleLog2Max - ScaleLog2Min));
		Disc.Color = float3((W2 >> 16) & 0xFF, (W2 >> 24) & 0xFF, W3 & 0xFF) / 255.0;

		// Smallest-three quaternion
		uint Largest = W4 & 3u;
		float Comps[4] = { 0.0, 0.0, 0.0, 0.0 };
		float SumSq = 0.0;
		uint Shift = 2;
		[unroll]
		for (uint i = 0; i < 4; i++)
		{
			if (i != Largest)
			{
				float V = ((((W4 >> Shift) & 0x3FFu) / 1023.0) * 2.0 - 1.0) * 0.70710678118;
				Comps[i] = V;
				SumSq += V * V;
				Shift += 10;
			}
		}
		Comps[Largest] = sqrt(saturate(1.0 - SumSq));
		float3x3 R = QuatToMat3(float4(Comps[0], Comps[1], Comps[2], Comps[3]));

		// The disc lies in the plane of the two largest scales (SplatRecordDisc)
		uint K = (Scale.x <= Scale.y && Scale.x <= Scale.z) ? 0u : (Scale.y <= Scale.z ? 1u : 2u);
		Normal = float3(R[0][K], R[1][K], R[2][K]);
		float SMax = max(Scale.x, max(Scale.y, Scale.z));
		float SMid = max(min(Scale.x, Scale.y), min(max(Scale.x, Scale.y), Scale.z));
		Radius = AutoSplatRadius(2.0 * sqrt(SMax * SMid) * SplatScale, 1.0, Lod);
		bLit = false; // Baked radiance
	}

	float4 ClipCenter = mul(float4(Disc.Center, 1.0), ModelToClip);
	float DistToCam = max(0.1, ClipCenter.w * ClipWToModel);
	Radius = max(Radius, DistToCam * 0.00015);

	SplatTangents(Normal, Radius, Disc.TangentX, Disc.TangentY);
	SolidDot(DistToCam, Disc.TangentX, Disc.TangentY);

	if (bLit && LitMode == 0)
	{
		// SplatPak's two-sided key light; in lit mode Unreal's lights shade the disc instead
		Disc.Color *= 0.35 + 0.65 * abs(dot(Normal, LightDirModel));
	}
	if ((StreamFlags & 2u) != 0 && Wave > 0.0 && Wave < 0.99)
	{
		float3 Glowing = Disc.Color;
		ArrivalGlow(Glowing, Wave, Lod);
		Disc.Glow = Glowing - Disc.Color;
	}
	// Discs are two-sided: the normal faces the camera. Billboards and records without a normal face it outright.
	const float3 ToEye = normalize(EyeModel - Disc.Center);
	if (OrientMode != 0 || abs(Normal.x) + abs(Normal.y) + abs(Normal.z) <= 0.1)
	{
		Normal = ToEye;
	}
	Disc.Normal = dot(Normal, ToEye) < 0.0 ? -Normal : Normal;
	return true;
}

FSplatPakVSOut DiscCornerVertex(FSplatPakDisc Disc, uint Corner, float BlendWeight)
{
	float2 CC = QuadCorners[Corner];
	FSplatPakVSOut O;
	O.Position = mul(float4(Disc.Center + Disc.TangentX * CC.x + Disc.TangentY * CC.y, 1.0), ModelToClip);
	O.UV = CC * 0.5 + 0.5;
	O.Color = Disc.Color;
	O.BlendWeight = BlendWeight;
	O.WorldNormal = mul(float4(Disc.Normal, 0.0), ModelToWorldNormal).xyz;
	O.Glow = Disc.Glow;
	return O;
}

FSplatPakVSOut CulledVertex()
{
	FSplatPakVSOut O;
	O.Position = CulledClipPos;
	O.UV = float2(0.0, 0.0);
	O.Color = float3(0.0, 0.0, 0.0);
	O.BlendWeight = 1.0;
	O.WorldNormal = float3(0.0, 0.0, 1.0);
	O.Glow = float3(0.0, 0.0, 0.0);
	return O;
}

// Conservative AABB-vs-frustum test. With Unreal's reversed, infinite-far depth the two z tests
// swap roles (z > w is in front of the near plane, z < 0 never happens), and the test stays correct.
bool MeshletInFrustum(FSplatPakMeshlet M)
{
	float3 BMin = M.AabbMin;
	float3 BMax = M.AabbMin + M.AabbExtents;
	uint OutL = 0, OutR = 0, OutB = 0, OutT = 0, OutN = 0, OutF = 0;
	[unroll]
	for (uint i = 0; i < 8; i++)
	{
		float3 P = float3((i & 1) ? BMax.x : BMin.x, (i & 2) ? BMax.y : BMin.y, (i & 4) ? BMax.z : BMin.z);
		float4 C = mul(float4(P, 1.0), ModelToClip);
		if (C.w > 0.0001)
		{
			OutL += (C.x < -C.w) ? 1 : 0;
			OutR += (C.x >  C.w) ? 1 : 0;
			OutB += (C.y < -C.w) ? 1 : 0;
			OutT += (C.y >  C.w) ? 1 : 0;
			OutN += (C.z <  0.0) ? 1 : 0;
			OutF += (C.z >  C.w) ? 1 : 0;
		}
		else
		{
			OutN++;
		}
	}
	return OutL < 8 && OutR < 8 && OutB < 8 && OutT < 8 && OutN < 8 && OutF < 8;
}

// Whether the meshlet lies behind the occluder at every grid pixel its bounding box covers (grown by one
// pixel, which absorbs the half pixel by which the raster's centre sampling can overreach a triangle's edge).
// The bounds are first grown by OccMeshletPad: they hold the splat centres, and a disc reaches its radius
// beyond its centre, towards the camera and sideways past the occluder's rim. Coarse levels draw large discs;
// without the pad Venus at its coarsest level lost 0.6% of its pixels (at level 0, none).
// Plain ifs throughout: older HLSL evaluates both sides of && and ?:.
bool MeshletOccluded(FSplatPakMeshlet M)
{
	if (OcclusionCull == 0) return false;
	float3 BMin = M.AabbMin - OccMeshletPad;
	float3 BMax = M.AabbMin + M.AabbExtents + OccMeshletPad;
	float NearW = 1e30;
	float2 Lo = float2(1e30, 1e30), Hi = float2(-1e30, -1e30);
	[unroll]
	for (uint i = 0; i < 8; i++)
	{
		float3 P = OccProject(float3((i & 1) ? BMax.x : BMin.x, (i & 2) ? BMax.y : BMin.y, (i & 4) ? BMax.z : BMin.z));
		if (P.z <= OccNearW) return false; // Reaches the near plane: never culled
		NearW = min(NearW, P.z);
		Lo = min(Lo, P.xy);
		Hi = max(Hi, P.xy);
	}
	int X0 = max(0, (int)floor(Lo.x) - 1), Y0 = max(0, (int)floor(Lo.y) - 1);
	int X1 = min((int)OccWidth - 1, (int)floor(Hi.x) + 1), Y1 = min((int)OccHeight - 1, (int)floor(Hi.y) + 1);
	if (X1 < X0 || Y1 < Y0) return false;
	if ((uint)((X1 - X0 + 1) * (Y1 - Y0 + 1)) > OCC_MAX_MESHLET_PIXELS) return false;
	for (int Y = Y0; Y <= Y1; Y++)
	{
		for (int X = X0; X <= X1; X++)
		{
			if (asfloat(OccDepth[Y * OccWidth + X]) >= NearW) return false; // Something of the meshlet may show here
		}
	}
	return true;
}

// ---------------------------------------------------------------------------------------------
// Mesh shader path (default wherever Mesh Shader Tier 1 is available)
// ---------------------------------------------------------------------------------------------

#if SPLATS_MESH_SHADER

struct FSplatPakPayload
{
	uint MeshletIndices[AS_GROUP_SIZE];
};

groupshared FSplatPakPayload SharedPayload;
groupshared uint SharedVisibleCount;

[numthreads(AS_GROUP_SIZE, 1, 1)]
void MainAS(uint3 GroupId : SV_GroupID, uint ThreadId : SV_GroupThreadID)
{
	if (ThreadId == 0)
	{
		SharedVisibleCount = 0;
	}
	GroupMemoryBarrierWithGroupSync();

	// Groups past 65535 fold over y (see AddDiscPass).
	uint MeshletIndex = (GroupId.y * 65535u + GroupId.x) * AS_GROUP_SIZE + ThreadId;
	bool bVisible = false;
	if (MeshletIndex < MeshletCount)
	{
		FSplatPakMeshlet M = Meshlets[MeshletIndex];
		if (MeshletInFrustum(M))
		{
			const bool bOccluded = MeshletOccluded(M);
			bVisible = (OcclusionCull == 2) ? bOccluded : !bOccluded;
		}
	}
	if (bVisible)
	{
		uint Slot;
		InterlockedAdd(SharedVisibleCount, 1, Slot);
		SharedPayload.MeshletIndices[Slot] = MeshletIndex;
	}
	GroupMemoryBarrierWithGroupSync();

	// Exactly one DispatchMesh per amplification shader (validator rule).
	DispatchMesh(SharedVisibleCount, 1, 1, SharedPayload);
}

[numthreads(SPLATS_PER_GROUP, 1, 1)]
[outputtopology("triangle")]
void MainMS(
	uint3 GroupId : SV_GroupID,
	uint ThreadId : SV_GroupThreadID,
	in payload FSplatPakPayload Payload,
	out indices uint3 Tris[SPLATS_PER_GROUP * 2],
	out vertices FSplatPakVSOut Verts[SPLATS_PER_GROUP * 4])
{
	FSplatPakMeshlet M = Meshlets[Payload.MeshletIndices[GroupId.x]];
	uint Count = min((uint)SPLATS_PER_GROUP, M.SplatCount);

	// Exactly one SetMeshOutputCounts per mesh shader (validator rule).
	SetMeshOutputCounts(Count * 4, Count * 2);
	if (ThreadId >= Count)
	{
		return;
	}

	uint VBase = ThreadId * 4;
	uint PBase = ThreadId * 2;
	FSplatPakDisc Disc;
	if (!BuildDisc(M.SplatOffset + ThreadId, M.LodLevel, M.IsSilhouette, Disc))
	{
		// Degenerate triangles and zeroed vertices for a record that draws nothing.
		Tris[PBase + 0] = uint3(0, 0, 0);
		Tris[PBase + 1] = uint3(0, 0, 0);
		[unroll]
		for (uint Z = 0; Z < 4; Z++)
		{
			FSplatPakVSOut O = CulledVertex();
			O.Position = float4(0.0, 0.0, 0.0, 0.0);
			Verts[VBase + Z] = O;
		}
		return;
	}

	[unroll]
	for (uint C = 0; C < 4; C++)
	{
		Verts[VBase + C] = DiscCornerVertex(Disc, C, M.BlendWeight);
	}
	Tris[PBase + 0] = uint3(VBase + 0, VBase + 1, VBase + 2);
	Tris[PBase + 1] = uint3(VBase + 1, VBase + 3, VBase + 2);
}

#endif // SPLATS_MESH_SHADER

// ---------------------------------------------------------------------------------------------
// Vertex shader fallback: DrawPrimitive(0, 2, MeshletCount * 64), one instance per splat slot
// ---------------------------------------------------------------------------------------------

void MainVS(uint VertexId : SV_VertexID, uint InstanceId : SV_InstanceID, out FSplatPakVSOut Out)
{
	uint MeshletIndex = InstanceId / SPLATS_PER_GROUP;
	uint Local = InstanceId - MeshletIndex * SPLATS_PER_GROUP;
	Out = CulledVertex();
	if (MeshletIndex >= MeshletCount)
	{
		return;
	}
	FSplatPakMeshlet M = Meshlets[MeshletIndex];
	if (Local >= M.SplatCount)
	{
		return;
	}
	FSplatPakDisc Disc;
	if (BuildDisc(M.SplatOffset + Local, M.LodLevel, M.IsSilhouette, Disc))
	{
		Out = DiscCornerVertex(Disc, QuadVertexCorner[VertexId % 6], M.BlendWeight);
	}
}

// ---------------------------------------------------------------------------------------------
// Pixel shader: hard-edged opaque disc into Unreal's linear, pre-exposed scene colour
// ---------------------------------------------------------------------------------------------

// SplatPak's 8x8 Bayer matrix (Splat.hlsl GetBayer8x8), for the complementary cross-dissolve between levels
float Bayer8x8(uint2 Pixel)
{
	static const float Bayer[64] = {
		 1.0, 49.0, 13.0, 61.0,  4.0, 52.0, 16.0, 64.0,
		33.0, 17.0, 45.0, 29.0, 36.0, 20.0, 48.0, 32.0,
		 9.0, 57.0,  5.0, 53.0, 12.0, 60.0,  8.0, 56.0,
		41.0, 25.0, 37.0, 21.0, 44.0, 28.0, 40.0, 24.0,
		 3.0, 51.0, 15.0, 63.0,  2.0, 50.0, 14.0, 62.0,
		35.0, 19.0, 47.0, 31.0, 34.0, 18.0, 46.0, 30.0,
		11.0, 59.0,  7.0, 55.0, 10.0, 58.0,  6.0, 54.0,
		43.0, 27.0, 39.0, 23.0, 42.0, 26.0, 38.0, 22.0 };
	return Bayer[(Pixel.y & 7u) * 8u + (Pixel.x & 7u)] / 64.0;
}

// The disc's round edge, then the cross-fade dither: shared by the unlit and the lit pass
void ClipDiscPixel(FSplatPakVSOut In)
{
	float2 Centered = In.UV * 2.0 - 1.0;
	if (dot(Centered, Centered) > 1.0)
	{
		discard;
	}
	// A block mid cross-fade: children fading in (+t) keep the pixels below t, the parent fading out (-t) the rest
	if ((StreamFlags & 1u) != 0 && abs(In.BlendWeight) < 0.999)
	{
		const float Threshold = Bayer8x8((uint2)In.Position.xy);
		if (In.BlendWeight >= 0.0)
		{
			if (Threshold >= In.BlendWeight) discard;
		}
		else
		{
			if (Threshold < -In.BlendWeight) discard;
		}
	}
}

void MainPS(FSplatPakVSOut In, out float4 OutColor : SV_Target0)
{
	ClipDiscPixel(In);
	float3 Graded = SRGBToLinearColor(In.Color + In.Glow) * ColourGain;
	const float Y = dot(Graded, float3(0.2126, 0.7152, 0.0722));
	Graded = max(Y + (Graded - Y) * ColourSaturation + ColourOffset, 0.0);
	OutColor = float4(Graded * EmissiveIntensity * PreExposure, 1.0);
}

#if SPLATS_GBUFFER

#include "/Engine/Private/DeferredShadingCommon.ush"

// Lit mode, drawn right after Unreal's base pass into its targets: scene colour (emissive) and GBufferA-C (normal;
// shading model, roughness, specular; base colour). The stored colour is baked light, so it is split by LitBlend:
// (1 - LitBlend) of it stays emissive, LitBlend of it becomes the albedo Unreal's lights, shadows and Lumen shade.
// The arrival glow stays emissive.
void MainGBufferPS(FSplatPakVSOut In,
	out float4 OutColor   : SV_Target0,
	out float4 OutGBufferA : SV_Target1,
	out float4 OutGBufferB : SV_Target2,
	out float4 OutGBufferC : SV_Target3)
{
	ClipDiscPixel(In);
	const float3 Baked = SRGBToLinearColor(In.Color);
	const float3 Glow = SRGBToLinearColor(In.Color + In.Glow) - Baked;
	OutColor = float4((Baked * (1.0 - LitBlend) + Glow) * EmissiveIntensity * PreExposure, 1.0);

	// The splats' own normals are noisy: near the shadow mesh's surface, lean on its smooth normal instead
	float3 Normal = normalize(In.WorldNormal);
	if (NormalSmoothing > 0.0)
	{
		const float4 Mesh = MeshNormalTexture.Load(int3(In.Position.xy, 0));
		if (Mesh.w > 0.0 && abs(Mesh.w - In.Position.w) < MeshNormalTolerance)
		{
			const float3 MeshNormal = dot(Mesh.xyz, Normal) < 0.0 ? -Mesh.xyz : Mesh.xyz; // Two-sided, like the disc
			Normal = normalize(lerp(Normal, MeshNormal, NormalSmoothing));
		}
	}

	FGBufferData GBuffer = (FGBufferData)0;
	GBuffer.WorldNormal = Normal;
	GBuffer.BaseColor = saturate(Baked * AlbedoScale * LitBlend);
	GBuffer.Metallic = 0.0;
	GBuffer.Specular = LitSpecular * LitBlend; // At LitBlend 0 nothing reflects either: exactly the unlit look
	GBuffer.Roughness = LitRoughness;
	GBuffer.GBufferAO = 1.0;
	GBuffer.IndirectIrradiance = 1.0;
	GBuffer.ShadingModelID = SHADINGMODELID_DEFAULT_LIT;
	// Nothing written to the precomputed-shadow or velocity targets: the lights must not read them for these pixels
	GBuffer.SelectiveOutputMask = SKIP_PRECSHADOW_MASK | SKIP_VELOCITY_MASK;
	float4 OutGBufferD, OutGBufferE, OutVelocity;
	EncodeGBuffer(GBuffer, OutGBufferA, OutGBufferB, OutGBufferC, OutGBufferD, OutGBufferE, OutVelocity);
}

#endif // SPLATS_GBUFFER
