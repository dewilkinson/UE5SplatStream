// SplatPakDropShadow.usf
// The drop shadow (SplatPakDropShadow.h): a caster's triangles, flattened onto a plane by ModelToPlane (translated world
// space), into an R8 mask at its opacity (max blended, so overlapping triangles do not darken twice), kept within
// ClipMin..ClipMax in x and y (the plinth's top for the shadows cast on it; unbounded on the floor); then, once the mask
// is blurred, the view's colour multiplied by one minus it.

#include "/Engine/Private/Common.ush"

StructuredBuffer<float> MeshPositions; // Three floats per vertex
StructuredBuffer<uint>  MeshIndices;   // Three per triangle
float4x4 ModelToPlane;                 // Model space to the flattened shadow, translated world
float4x4 PlaneToClip;                  // Translated world to clip
float2   ClipMin;                      // Translated world x and y
float2   ClipMax;
float    Opacity;

void MaskVS(uint VertexId : SV_VertexID, out float4 Position : SV_POSITION, out float2 PlaneXY : TEXCOORD0)
{
	const uint I = MeshIndices[VertexId];
	const float3 P = float3(MeshPositions[I * 3], MeshPositions[I * 3 + 1], MeshPositions[I * 3 + 2]);
	const float4 OnPlane = mul(float4(P, 1.0), ModelToPlane);
	PlaneXY = OnPlane.xy / OnPlane.w;
	Position = mul(OnPlane, PlaneToClip);
}

void MaskPS(float4 Position : SV_POSITION, float2 PlaneXY : TEXCOORD0, out float4 OutColor : SV_Target0)
{
	if (any(PlaneXY < ClipMin) || any(PlaneXY > ClipMax)) discard;
	OutColor = Opacity;
}

Texture2D Mask;

void CompositePS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float M = saturate(Mask.Load(int3(int2(SvPosition.xy), 0)).r);
	OutColor = float4((1.0 - M).xxx, 1.0); // Multiplied into the scene colour by the blend state
}
