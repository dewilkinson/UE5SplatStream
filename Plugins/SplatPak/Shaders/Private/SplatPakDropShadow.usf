// SplatPakDropShadow.usf
// The drop shadow (SplatPakDropShadow.h): a caster's triangles, already flattened onto the floor by ModelToClip, into an
// R8 mask at its opacity (max blended, so overlapping triangles do not darken twice); then, once the mask is blurred,
// the view's colour multiplied by one minus it.

#include "/Engine/Private/Common.ush"

StructuredBuffer<float> MeshPositions; // Three floats per vertex
StructuredBuffer<uint>  MeshIndices;   // Three per triangle
float4x4 ModelToClip;                  // Includes the projection onto the floor
float    Opacity;

void MaskVS(uint VertexId : SV_VertexID, out float4 Position : SV_POSITION)
{
	const uint I = MeshIndices[VertexId];
	const float3 P = float3(MeshPositions[I * 3], MeshPositions[I * 3 + 1], MeshPositions[I * 3 + 2]);
	Position = mul(float4(P, 1.0), ModelToClip);
}

void MaskPS(float4 Position : SV_POSITION, out float4 OutColor : SV_Target0)
{
	OutColor = Opacity;
}

Texture2D Mask;

void CompositePS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float M = saturate(Mask.Load(int3(int2(SvPosition.xy), 0)).r);
	OutColor = float4((1.0 - M).xxx, 1.0); // Multiplied into the scene colour by the blend state
}
